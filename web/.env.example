# Results base URL. Default /data (synced from ../data by `npm run sync-data`).
# For live AWS results use the API: https://tlnp8w02m4.execute-api.us-west-2.amazonaws.com
NEXT_PUBLIC_DATA_URL=

# Alerts API (POST /watch, /unwatch). Leave empty to show alerts as unavailable.
NEXT_PUBLIC_API_URL=https://tlnp8w02m4.execute-api.us-west-2.amazonaws.com

# Public site URL, used for Open Graph links.
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Plot Check API (infra/plot/setup.sh lambdas prints it). Leave empty to hide Plot Check.
NEXT_PUBLIC_PLOT_API_URL=
