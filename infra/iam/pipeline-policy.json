{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "ReadWriteResults",
      "Effect": "Allow",
      "Action": [
        "s3:PutObject",
        "s3:GetObject"
      ],
      "Resource": "arn:aws:s3:::kerewatch-results-468094683747/lakes/*"
    },
    {
      "Sid": "WriteLakeSummaries",
      "Effect": "Allow",
      "Action": [
        "dynamodb:PutItem",
        "dynamodb:UpdateItem"
      ],
      "Resource": "arn:aws:dynamodb:us-west-2:468094683747:table/kerewatch-lakes"
    },
    {
      "Sid": "AlertWatchers",
      "Effect": "Allow",
      "Action": [
        "sns:Publish"
      ],
      "Resource": "arn:aws:sns:us-west-2:468094683747:kerewatch-alerts"
    }
  ]
}
